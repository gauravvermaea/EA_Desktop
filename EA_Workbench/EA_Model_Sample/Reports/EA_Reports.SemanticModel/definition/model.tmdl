model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-ZA
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["ModelFolder", "Entity", "EntityAttribute", "EntityType", "Relationships", "Target Entity", "Issues"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table 'Entity'
ref table 'EntityAttribute'
ref table 'EntityType'
ref table 'Relationships'
ref table 'Target Entity'
ref table 'Issues'
