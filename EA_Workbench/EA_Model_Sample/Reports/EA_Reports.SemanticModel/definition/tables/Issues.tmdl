		sourceColumn: Message

		annotation SummarizationSetBy = Automatic

	partition 'Issues' = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(ModelFolder & "EA_Core.xlsm"), null, true),
				    Issues = Source{[Item="tblIssues",Kind="Table"]}[Data],
				    Rows = Table.SelectRows(Issues, each [Severity] <> null and [Severity] <> ""),
				    Picked = Table.SelectColumns(Rows, {"Found", "Sheet", "RecordID", "DisplayID", "Name", "TypeCode", "AttrCode", "RuleType", "Severity", "Message"}),
				    Typed = Table.TransformColumnTypes(Picked, {{"Found", type text}, {"Sheet", type text}, {"RecordID", type text}, {"DisplayID", type text}, {"Name", type text}, {"TypeCode", type text}, {"AttrCode", type text}, {"RuleType", type text}, {"Severity", type text}, {"Message", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table
