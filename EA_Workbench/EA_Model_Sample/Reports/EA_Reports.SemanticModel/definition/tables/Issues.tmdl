table 'Issues'
	lineageTag: d9629de4-debd-58c9-a52c-449e86a27686

	measure 'Errors' = CALCULATE(COUNTROWS(Issues), Issues[Severity] = "Error")
		formatString: 0
		lineageTag: f7533404-3b00-569d-88b2-6bea479be59b

	measure 'Warnings' = CALCULATE(COUNTROWS(Issues), Issues[Severity] = "Warning")
		formatString: 0
		lineageTag: ce3f4a92-23d3-50cf-b4d1-5be340943db4

	column 'Found'
