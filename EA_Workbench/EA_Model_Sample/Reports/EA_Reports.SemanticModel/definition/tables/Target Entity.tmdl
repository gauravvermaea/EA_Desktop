	partition 'Target Entity' = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(ModelFolder & "EA_Core.xlsm"), null, true),
				    Master = Source{[Item="tblMaster",Kind="Table"]}[Data],
				    Rows = Table.SelectRows(Master, each [Entity ID] <> null and [Entity ID] <> ""),
				    Types = Table.SelectColumns(Source{[Item="tblEntityTypes",Kind="Table"]}[Data], {"TypeCode", "Name", "Domain"}),
				    Joined = Table.NestedJoin(Rows, {"Type"}, Types, {"TypeCode"}, "T", JoinKind.LeftOuter),
				    Expanded = Table.ExpandTableColumn(Joined, "T", {"Name", "Domain"}, {"Target Type Name", "Target Domain"}),
				    Picked = Table.SelectColumns(Expanded, {"Entity ID", "Display ID", "Name", "Status", "Target Type Name", "Target Domain"}),
				    Renamed = Table.RenameColumns(Picked, {{"Entity ID", "Target ID"}, {"Display ID", "Target Display ID"}, {"Name", "Target Name"}, {"Status", "Target Status"}}),
				    Typed = Table.TransformColumnTypes(Renamed, {{"Target ID", type text}, {"Target Display ID", type text}, {"Target Name", type text}, {"Target Status", type text}, {"Target Type Name", type text}, {"Target Domain", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table
