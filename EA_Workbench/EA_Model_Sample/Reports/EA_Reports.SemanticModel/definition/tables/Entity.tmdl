		annotation SummarizationSetBy = Automatic

	column 'Repository Area'
		dataType: string
		lineageTag: b31eee48-a503-5f50-867e-aaf45f426c61
		summarizeBy: none
		sourceColumn: Repository Area

		annotation SummarizationSetBy = Automatic

	column 'TypeCode'
		dataType: string
		lineageTag: e4749b27-420f-52df-8a3f-e1adddf5eeb2
		summarizeBy: none
		sourceColumn: TypeCode

		annotation SummarizationSetBy = Automatic

	column 'Modified'
		dataType: string
		lineageTag: ff6a515e-ecb6-5348-a5c9-26e4b79e5ae7
		summarizeBy: none
		sourceColumn: Modified

		annotation SummarizationSetBy = Automatic

	partition 'Entity' = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(ModelFolder & "EA_Core.xlsm"), null, true),
				    Master = Source{[Item="tblMaster",Kind="Table"]}[Data],
				    Rows = Table.SelectRows(Master, each [Entity ID] <> null and [Entity ID] <> ""),
				    Picked = Table.SelectColumns(Rows, {"Entity ID", "Display ID", "Name", "Description", "Status", "Repository Area", "Type", "Modified"}),
				    Renamed = Table.RenameColumns(Picked, {{"Type", "TypeCode"}}),
				    Typed = Table.TransformColumnTypes(Renamed, {{"Entity ID", type text}, {"Display ID", type text}, {"Name", type text}, {"Description", type text}, {"Status", type text}, {"Repository Area", type text}, {"TypeCode", type text}, {"Modified", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table
