table 'Entity'
	lineageTag: 7a2cb1ea-0e1d-5511-9c3d-78b024f1dff9

	measure 'Entities' = COUNTROWS('Entity')
		formatString: 0
		lineageTag: 45aa85f5-7b85-5292-af5a-b841af969012

	measure 'Retired entities' = CALCULATE(COUNTROWS('Entity'), 'Entity'[Status] = "Retired")
		formatString: 0
		lineageTag: d04fbd8f-77bc-517f-a897-37b8035ad919

	measure 'Data quality %' = 1 - DIVIDE(CALCULATE(DISTINCTCOUNT(Issues[RecordID]), Issues[Severity] = "Error", Issues[Sheet] = "DATA_Master"), COUNTROWS('Entity'), 0)
		formatString: 0%
		lineageTag: d6f54e22-db41-5c25-9532-2bda24003442

	column 'Entity ID'
		dataType: string
		lineageTag: 29fe2928-e454-5aeb-a799-4682c805510d
		summarizeBy: none
		sourceColumn: Entity ID

		annotation SummarizationSetBy = Automatic

	column 'Display ID'
		dataType: string
		lineageTag: 97420731-7964-5ff7-b63f-977adf3b0e64
		summarizeBy: none
		sourceColumn: Display ID

		annotation SummarizationSetBy = Automatic

	column 'Name'
		dataType: string
		lineageTag: e083bd89-c0d3-5c3f-a870-933f18d6aede
		summarizeBy: none
		sourceColumn: Name

